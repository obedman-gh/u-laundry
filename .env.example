# Salin ke .env hanya untuk instalasi baru. Jangan commit .env atau secret nyata.
# Nilai kosong JWT_SECRET/COOKIE_SECRET sengaja membuat startup gagal sampai diisi.
# Environment sistem mengungguli .env; .env tidak wajib ada pada deployment.
# Pilihan: development, test, production. Production wajib disetel eksplisit.
APP_ENV=development

# Bind lokal secara default; ubah hanya sesuai rancangan reverse proxy/infrastruktur.
SERVER_ADDRESS=127.0.0.1:8080
STATIC_DIR=./frontend
# Semua timeout durasi Go positif; read-header tidak boleh melebihi read.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=5s

# Pilih SATU sumber koneksi: komponen di bawah ATAU DB_DSN (URL PostgreSQL).
# Jika DB_DSN diisi, hapus/comment semua DB_HOST/PORT/USER/PASS/NAME/SSLMODE/SSLROOTCERT.
# DB_DSN hanya menerima postgres:// atau postgresql://, satu host TCP + user + database.
# Percent-encode username/password/CA path bila perlu; query hanya sslmode dan sslrootcert.
# DB_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=%2Fpath%2Fca.crt
# Gunakan role aplikasi dengan hak minimum; jangan memakai superuser untuk production.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ulaundry
DB_PASS=
DB_NAME=ulaundry_dev
# disable hanya untuk development/test. Production wajib verify-full + CA eksplisit.
# require/verify-ca boleh dipakai nonproduction; allow/prefer/custom SSL mode ditolak.
DB_SSLMODE=disable
# Path CA PEM yang dapat dibaca, atau system untuk trust store OS (wajib verify-full).
DB_SSLROOTCERT=
# Production juga mewajibkan host/user/nama database/SSL mode eksplisit dan password
# database non-placeholder minimal 16 byte; tidak membaca override PG*/pgpass/service.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# max-open >= 1; 0 <= max-idle <= max-open. Lifetime/timeout harus positif.
# connect timeout tidak boleh melebihi ping timeout; diterapkan juga oleh driver.
DB_CONNECT_TIMEOUT=5s
DB_PING_TIMEOUT=5s

# Isi secret acak, bukan placeholder, minimal 32 byte masing-masing pada semua mode.
# Production mewajibkan kedua kunci berbeda. Tidak ada kunci default bawaan.
JWT_SECRET=
COOKIE_SECRET=
# Konfigurasi cookie disiapkan; autentikasi saat ini tetap JWT Bearer/localStorage.
# Production wajib true; SameSite none juga memerlukan Secure true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# PUBLIC_BASE_URL adalah origin root, tanpa user/path/query/fragment.
# Production wajib URL HTTPS eksplisit, misalnya https://laundry.domain-pemilik.
PUBLIC_BASE_URL=http://localhost:8080
# Daftar origin penuh, dipisah koma; wajib mencakup PUBLIC_BASE_URL.
# Jika tidak diisi, hanya origin PUBLIC_BASE_URL yang dipercaya; tidak ada wildcard.
# Semua origin production wajib HTTPS. ALLOWED_ORIGIN adalah alias lama, jangan
# dipakai bersamaan dengan TRUSTED_ORIGINS.
TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Pilihan: debug, info, warn, error. Tidak mencetak konfigurasi/secret/DSN.
LOG_LEVEL=info
